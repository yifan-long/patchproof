# PatchProof defaults to its own safe validation fixture. Provider values are
# read-only from the existing researchflow source; secrets are never copied.
PATCHPROOF_REPO_PATH=benchmarks/fixtures/validation
PATCHPROOF_ENV_FILE=../archive/researchflow/.env
PATCHPROOF_API_HOST=127.0.0.1
PATCHPROOF_API_PORT=8010
PATCHPROOF_MAX_ITERATIONS=3
PATCHPROOF_MAX_TOOL_STEPS=32
PATCHPROOF_MAX_FILE_BYTES=200000
PATCHPROOF_DATABASE_PATH=data/patchproof.db
PATCHPROOF_COMMAND_TIMEOUT_SECONDS=120
PATCHPROOF_CLEANUP_WORKSPACES=false
PATCHPROOF_EVALUATION_FIRST_PASS_BUDGET_USD=2
PATCHPROOF_EVALUATION_EXPANSION_BUDGET_USD=20
PATCHPROOF_EVALUATION_MAX_REQUESTS=40
PATCHPROOF_EVALUATION_MAX_TOKENS=32768
PATCHPROOF_EVALUATION_RESERVE_OUTPUT_TOKENS=4096
# Docker image/registry/mirror are explicit configuration only. Do not mutate
# daemon settings automatically. A production/real image must use @sha256.
# PATCHPROOF_DOCKER_IMAGE=registry.example/patchproof-python312@sha256:<verified>
# PATCHPROOF_DOCKER_REGISTRY=registry.example
# PATCHPROOF_DOCKER_MIRROR=mirror.example
# TUNA mirrors, if needed, belong only in setup apt/pip/package arguments.

# Optional PATCHPROOF_* overrides. If omitted, values are mapped from
# DEEPSEEK_API_KEY, DEEPSEEK_BASE_URL, DEEPSEEK_MODEL,
# DEEPSEEK_MAX_TOKENS, and MODEL_COST_PER_MILLION_TOKENS in the source file.
# DEEPSEEK_* selects the OpenAI-compatible transport. Override explicitly with:
# PATCHPROOF_LLM_PROVIDER=anthropic|deepseek|custom
# PATCHPROOF_LLM_TRANSPORT=anthropic-compatible|openai-compatible
# PATCHPROOF_OPENCODE_PLAN=auto|zen|go
# PATCHPROOF_LLM_REASONING=auto|on|off  (off forwards reasoning_effort=none for OpenAI-compatible)
# PATCHPROOF_LLM_TIMEOUT_SECONDS=120
# PATCHPROOF_LLM_MAX_RETRIES=2
# Store only PATCHPROOF_OPENCODE_PLAN in .patchproof.local.env. Never put API
# keys in that local profile file; credentials stay in the read-only source.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=deepseek-chat
# ANTHROPIC_BASE_URL=
